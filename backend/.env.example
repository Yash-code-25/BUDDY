# Copy this file to .env (same folder) and fill it in. .env is never committed.
# Leave EMAIL_USER empty to print emails in the runserver terminal instead of sending them.

# The account COMPASS sends from. For Gmail: turn on 2-Step Verification, then create an
# App password at https://myaccount.google.com/apppasswords and paste its 16 letters below.
EMAIL_USER=
EMAIL_PASSWORD=

# Gmail by default. Outlook.com / Hotmail: smtp-mail.outlook.com. Microsoft 365: smtp.office365.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# The database. Leave empty to use the SQLite file (db.sqlite3). For Supabase: Connect > Session pooler,
# copy the URI and put your database password in it. Write an @ in the password as %40.
DATABASE_URL=

# Live only (set these in the host's Environment Variables, e.g. on Vercel). Leave them out on a laptop.
# DJANGO_SECRET_KEY=   a long random string
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=compass.united-group.in,.vercel.app
# FRONTEND_URL=https://compass.united-group.in
# CRON_SECRET=   another long random string (Vercel's daily job sends it)
